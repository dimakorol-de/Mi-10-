<template>
  <div class="container" onswipe="handleSwipe">
    
    <!-- ГЛАВНОЕ МЕНЮ -->
    <div if="{{view === 'list'}}" class="list-container">
      <text class="title">Заметки</text>
      <input type="button" class="btn btn-add" value="+ Новая" onclick="createNote" />
      <div class="note-item" style="background-color: {{item.color || '#1c1c1e'}}" for="{{(index, item) in notes}}" onclick="openNote(index)">
        <text class="note-title">{{item.text || 'Пустая заметка'}}</text>
      </div>
    </div>

    <!-- ПРОСМОТР ЗАМЕТКИ -->
    <div if="{{view === 'read'}}" class="read-container">
      <div class="header" show="{{!isFocusMode}}">
        <input type="button" class="btn btn-sm" value="← Назад" onclick="goToList" />
        <input type="button" class="btn btn-sm btn-red" value="Удалить" onclick="deleteNote" />
      </div>
      
      <!-- Тройное нажатие активирует полноэкранный режим -->
      <scroll class="text-scroll" style="height: {{isFocusMode ? '250px' : '100px'}}" scroll-y="true">
        <text class="note-text" onclick="handleTripleTap" ondblclick="editNote">{{notes[currentIndex].text}}</text>
      </scroll>
      
      <div class="color-picker" show="{{!isFocusMode}}">
        <input type="button" class="color-btn" style="background-color: #007aff" onclick="updateColor('#007aff')" />
        <input type="button" class="color-btn" style="background-color: #ff453a" onclick="updateColor('#ff453a')" />
        <input type="button" class="color-btn" style="background-color: #34c759" onclick="updateColor('#34c759')" />
      </div>
      
      <input type="button" class="btn btn-edit" value="Редактировать" onclick="editNote" show="{{!isFocusMode}}" />
    </div>

    <!-- РЕДАКТИРОВАНИЕ (КЛАВИАТУРА) -->
    <div if="{{view === 'edit'}}" class="edit-container">
      <div class="header">
        <input type="button" class="btn btn-save" value="Сохранить" onclick="saveAndRead" />
      </div>
      
      <scroll class="text-scroll" scroll-y="true">
        <text class="note-text">{{text}}</text>
      </scroll>
      
      <div class="row">
        <input type="button" class="btn btn-action" value="⌫" onclick="deleteChar" />
        <input type="button" class="btn btn-action btn-space" value="Пробел" onclick="addChar(' ')" />
        <input type="button" class="btn btn-action" value="{{langButtonText}}" onclick="toggleKeyboard" />
      </div>

      <scroll class="keyboard-scroll" scroll-x="true">
        <div class="keyboard-inner">
          <div class="row" for="{{row in currentKeyboard}}">
            <input type="button" class="btn key" for="{{char in row}}" value="{{char}}" onclick="addChar(char)" />
          </div>
        </div>
      </scroll>
    </div>

  </div>
</template>

<style>
  .container { flex-direction: column; align-items: center; justify-content: center; padding: 40px 10px; background-color: #000000; height: 100%; }
  .list-container, .read-container, .edit-container { flex-direction: column; align-items: center; width: 100%; }
  .title { font-size: 24px; font-weight: bold; color: #ffffff; margin-bottom: 15px; }
  
  .btn { background-color: #2c2c2e; color: #ffffff; border-radius: 10px; font-size: 18px; }
  .btn-add { width: 200px; height: 45px; margin-bottom: 15px; }
  
  .note-item { width: 200px; padding: 12px; border-radius: 10px; margin-bottom: 8px; }
  .note-title { font-size: 18px; color: #ffffff; lines: 1; text-overflow: ellipsis; }
  
  .header { width: 220px; flex-direction: row; justify-content: space-between; margin-bottom: 15px; }
  .btn-sm { width: 100px; height: 40px; font-size: 16px; }
  .btn-red { background-color: #ff453a; }
  .btn-save { width: 220px; height: 45px; background-color: #34c759; margin-bottom: 10px; }
  .btn-edit { width: 220px; height: 45px; background-color: #007aff; margin-top: 10px; }
  
  .color-picker { flex-direction: row; justify-content: center; margin-top: 10px; margin-bottom: 10px; }
  .color-btn { width: 30px; height: 30px; border-radius: 15px; margin: 0 10px; }
  
  .text-scroll { width: 220px; background-color: #1c1c1e; border-radius: 10px; }
  .note-text { font-size: 20px; color: #ffffff; padding: 10px 15px; }
  
  .row { flex-direction: row; margin-bottom: 6px; justify-content: center; }
  .btn-action { width: 70px; height: 45px; font-size: 16px; margin: 0 3px; }
  .btn-space { width: 80px; }
  
  .keyboard-scroll { width: 240px; margin-top: 5px; }
  .keyboard-inner { flex-direction: column; padding: 0 15px; }
  .key { width: 35px; height: 45px; font-size: 18px; margin: 0 3px; flex-shrink: 0; }
</style>

<script>
import storage from '@system.storage';
import app from '@system.app';

export default {
  private: {
    view: 'list', notes: [], currentIndex: -1, text: '', keyboardMode: 0,
    isFocusMode: false, tapCount: 0, lastTapTime: 0,
    lettersRU: [['Й','Ц','У','К','Е','Н','Г','Ш','Щ','З'],['Ф','Ы','В','А','П','Р','О','Л','Д','Ж'],['Я','Ч','С','М','И','Т','Ь','Б','Ю','Х']],
    lettersEN: [['Q','W','E','R','T','Y','U','I','O','P'],['A','S','D','F','G','H','J','K','L'],['Z','X','C','V','B','N','M']],
    symbols: [['1','2','3','4','5','6','7','8','9','0'],['+','-','=','*','/','"',"'",'.',',']]
  },
  computed: {
    currentKeyboard() { return this.keyboardMode === 0 ? this.lettersRU : this.keyboardMode === 1 ? this.lettersEN : this.symbols; },
    langButtonText() { return this.keyboardMode === 0 ? 'EN' : this.keyboardMode === 1 ? '123' : 'RU'; }
  },
  onInit() { this.load(); },
  load() { storage.get({ key: 'notes_list', success: (data) => { this.notes = data ? JSON.parse(data) : []; } }); },
  save() { storage.set({ key: 'notes_list', value: JSON.stringify(this.notes) }); },
  createNote() { this.notes.push({text: '', color: '#1c1c1e'}); this.currentIndex = this.notes.length - 1; this.text = ''; this.view = 'edit'; },
  openNote(index) { this.currentIndex = index; this.isFocusMode = false; this.view = 'read'; },
  editNote() { this.text = this.notes[this.currentIndex].text || ''; this.view = 'edit'; },
  saveAndRead() { this.notes[this.currentIndex].text = this.text; this.save(); this.view = 'read'; },
  updateColor(color) { this.notes[this.currentIndex].color = color; this.save(); },
  deleteNote() { this.notes.splice(this.currentIndex, 1); this.save(); this.view = 'list'; },
  goToList() { this.view = 'list'; },
  addChar(char) { this.text += char; },
  deleteChar() { this.text = this.text.slice(0, -1); },
  toggleKeyboard() { this.keyboardMode = (this.keyboardMode + 1) % 3; },
  handleTripleTap() {
    const now = new Date().getTime();
    if (now - this.lastTapTime < 300) {
      this.tapCount++;
    } else {
      this.tapCount = 1;
    }
    this.lastTapTime = now;
    
    if (this.tapCount === 3) {
      this.isFocusMode = !this.isFocusMode;
      this.tapCount = 0;
    }
  },
  handleSwipe(evt) {
    if (evt.direction === 'right') {
      if (this.view === 'edit') this.saveAndRead();
      else if (this.view === 'read') this.goToList();
      else app.terminate();
    }
  }
}
</script>
